{
  "name": "@openclaw-swarm/coordination",
  "version": "0.1.0",
  "type": "module",
  "description": "Lightweight agent coordination layer for OpenClaw Swarm",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/communication/*": "./dist/communication/*.js",
    "./dist/state/*": "./dist/state/*.js",
    "./dist/discovery/*": "./dist/discovery/*.js",
    "./dist/optimization/*": "./dist/optimization/*.js",
    "./dist/api/*": "./dist/api/*.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run src/__tests__/",
    "test:watch": "vitest src/__tests__/"
  },
  "keywords": [
    "mqtt",
    "swarm",
    "agent",
    "coordination",
    "discovery"
  ],
  "dependencies": {
    "better-sqlite3": "^11.9.0",
    "eventemitter3": "^5.0.4",
    "express": "^4.18.0",
    "mqtt": "^5.0.0",
    "msgpackr": "^0.6.0",
    "node-cron": "^3.0.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.11",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}
